#include <iostream>
using namespace std;

int main() {
    float salary[10], total = 0, average;
    cout << "Enter salaries of 10 employees: ";
    for (int i = 0; i < 10; i++) {
        cin >> salary[i];
        total += salary[i];
    }
    average = total / 10;
    cout << "Total salary: " << total << endl;
    cout << "Average salary: " << average << endl;
    return 0;
}

