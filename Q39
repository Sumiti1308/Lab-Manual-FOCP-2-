#include <iostream>
using namespace std;

int main() {
    int rows;
    cout << "Enter number of rows: ";
    cin >> rows;

    for (int i = 0; i < rows; i++) {
        int val = 1;
        for (int j = 0; j < rows - i - 1; j++) cout << " "; // spacing
        for (int j = 0; j <= i; j++) {
            cout << val << " ";
            val = val * (i - j) / (j + 1); // iterative formula
        }
        cout << endl;
    }
    return 0;
}
