#include <iostream>
#include <cmath>
using namespace std;

int main() {
    int num, sum = 0, temp, digits = 0, armstrongSum = 0;
    cout << "Enter a number: ";
    cin >> num;

    for (int i = 1; i < num; i++) {
        if (num % i == 0) sum += i;
    }
    if (sum == num) cout << num << " is a Perfect number" << endl;
    else cout << num << " is not a Perfect number" << endl;

    temp = num;
    while (temp > 0) {
        digits++;
        temp /= 10;
    }
    temp = num;
    while (temp > 0) {
        int digit = temp % 10;
        armstrongSum += pow(digit, digits);
        temp /= 10;
    }
    if (armstrongSum == num) cout << num << " is an Armstrong number" << endl;
    else cout << num << " is not an Armstrong number" << endl;

    return 0;
}
