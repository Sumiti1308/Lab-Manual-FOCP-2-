#include <iostream>
using namespace std;

int main() {
    int choice;
    float a, b, result;
    do {
        cout << "\nMenu:\n1. Addition\n2. Subtraction\n3. Multiplication\n4. Division\n5. Exit\nEnter choice: ";
        cin >> choice;
        if (choice >= 1 && choice <= 4) {
            cout << "Enter two numbers: ";
            cin >> a >> b;
            switch (choice) {
                case 1: result = a + b; break;
                case 2: result = a - b; break;
                case 3: result = a * b; break;
                case 4: result = a / b; break;
            }
            cout << "Result: " << result << endl;
        }
    } while (choice != 5);
    return 0;
}
