#include <iostream>
using namespace std;

int main() {
    int n;
    float num, maxNum;
    cout << "Enter number of entries: ";
    cin >> n;
    cout << "Enter sales figures: ";
    cin >> maxNum;
    for (int i = 2; i <= n; i++) {
        cin >> num;
        if (num > maxNum) maxNum = num;
    }
    cout << "Maximum sales figure: " << maxNum << endl;
    return 0;
}
