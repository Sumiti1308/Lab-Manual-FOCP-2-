#include <iostream>
using namespace std;

int main() {
    int a, b, temp;

    cout << "Enter first number: ";
    cin >> a;
    cout << "Enter second number: ";
    cin >> b;

    cout << "\nOriginal values: a = " << a << ", b = " << b << endl;

    temp = a;
    a = b;
    b = temp;
    cout << "After swap (using temp): a = " << a << ", b = " << b << endl;

    a = a + b;
    b = a - b;
    a = a - b;
    cout << "After swap (using arithmetic): a = " << a << ", b = " << b << endl;

    a = a ^ b;
    b = a ^ b;
    a = a ^ b;
    cout << "After swap (using XOR): a = " << a << ", b = " << b << endl;

    return 0;
}
