#include <iostream>
using namespace std;

int main() {
    int num, flag = 0;
    cout << "Enter a number: ";
    cin >> num;
    if (num <= 1) {
        cout << "Not Prime" << endl;
        return 0;
    }
    for (int i = 2; i <= num / 2; i++) {
        if (num % i == 0) {
            flag = 1;
            break;
        }
    }
    if (flag == 0) cout << "Prime" << endl;
    else cout << "Not Prime" << endl;
    return 0;
}
