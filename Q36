#include <iostream>
using namespace std;

int main() {
    int m, n, p, q;
    cout << "Enter order of first matrix (m n): ";
    cin >> m >> n;
    cout << "Enter order of second matrix (p q): ";
    cin >> p >> q;

    if (n != p) {
        cout << "Matrix multiplication not possible." << endl;
        return 0;
    }

    int a[m][n], b[p][q], result[m][q];
    cout << "Enter first matrix: ";
    for (int i = 0; i < m; i++)
        for (int j = 0; j < n; j++)
            cin >> a[i][j];

    cout << "Enter second matrix: ";
    for (int i = 0; i < p; i++)
        for (int j = 0; j < q; j++)
            cin >> b[i][j];

    for (int i = 0; i < m; i++) {
        for (int j = 0; j < q; j++) {
            result[i][j] = 0;
            for (int k = 0; k < n; k++) {
                result[i][j] += a[i][k] * b[k][j];
            }
        }
    }

    cout << "Resultant matrix:" << endl;
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < q; j++) {
            cout << result[i][j] << " ";
        }
        cout << endl;
    }
    return 0;
}
